{
  "outputDirectory": "app/frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://RAILWAY_BACKEND_URL/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://RAILWAY_BACKEND_URL/health"
    }
  ],
  "headers": [
    {
      "source": "/dashboard_*.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    }
  ]
}
