# Vercel serves only static frontend files from app/frontend/.
# The FastAPI backend runs on Railway — proxied via vercel.json rewrites.
# api/index.py exists only to satisfy Vercel's FastAPI entrypoint detection.
requirements.txt
src/
app/backend/
docker/
notebooks/
scripts/
data/
reports/
Makefile
*.py
*.toml
*.cfg
*.ini
!api/index.py
!api/requirements.txt
