# ==========================
# Ambiente Virtual Python
# ==========================
.venv/
__pycache__/
*.pyc
*.pyo

# ==========================
# Dados brutos (pesados, baixar via script)
# ==========================
data/raw/*.csv
data/raw/*.zip
data/raw/*.xlsx
data/raw/*.jsonl

# ==========================
# Dados processados (gerados via script)
# ==========================
data/processed/*.csv
data/processed/*.parquet
data/processed/*.xlsx

# ==========================
# Arquivos de sistema
# ==========================
.DS_Store
Thumbs.db
*.swp
*.swo

# ==========================
# IDE & Node
# ==========================
.vscode/
.idea/
node_modules/

# ==========================
# Dashboard JSONs
# ==========================
# Fonte canônica versionável: data/processed/dashboard/dashboard_*.json
# Espelho legado gerado localmente para app/frontend/ não deve voltar ao Git.
app/frontend/dashboard*.json

# ==========================
# Manter estas pastas no Git (via .gitkeep)
# ==========================
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local secrets
.env
.env.*

# IDE & Tools
.cursor/
.codex/
.playwright/
.playwright-cli/
playwright-cli.json

# Output and logs
output/

# Test runner artifacts
test-results/

# Claude Code worktrees
.claude/

# QA reports temporários que caem na raiz
.qa-report-*.txt

# Playwright MCP screenshots/logs (gerados automaticamente)
.playwright-mcp/

# Screenshots de teste temporários (raiz e pasta de screenshots)
*.png
docs/screenshots/

# Processed data subdirectories
data/processed/**/*.csv
data/processed/**/*.parquet
data/processed/**/*.xlsx
!data/processed/analysis/**/*.csv
.vercel
.env*.local

# Texto escrito do TCC (privado até defesa)
Tcc_escrito/
