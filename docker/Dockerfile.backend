FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVE_STATIC=true

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src /app/src
COPY app /app/app
COPY data/processed/analysis /app/data/processed/analysis
COPY data/processed/dashboard /app/data/processed/dashboard
COPY docker/railway-start.sh /app/docker/railway-start.sh

EXPOSE 8051

RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

CMD ["uvicorn", "app.backend.main:app", "--host", "0.0.0.0", "--port", "8051"]
